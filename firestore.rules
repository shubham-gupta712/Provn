rules_version = '2';
// Provn — Firestore security rules (full file). Firebase project: provn-96604
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function str(v, max) { return v is string && v.size() <= max; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'shubhamgupta1414@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function notBanned() { return !exists(/databases/$(database)/documents/bans/$(me())); }
    function okMedia(u) {
      return u is string && u.size() < 400
        && u.matches('https://res[.]cloudinary[.]com/y3geoabc/(image|video)/upload/.*');
    }
    function mediaOk(m) {
      return m is list && m.size() <= 4
        && (m.size() < 1 || okMedia(m[0].url)) && (m.size() < 2 || okMedia(m[1].url))
        && (m.size() < 3 || okMedia(m[2].url)) && (m.size() < 4 || okMedia(m[3].url));
    }
    function counterOnly(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && (request.resource.data[field] == resource.data[field] + 1
            || request.resource.data[field] == resource.data[field] - 1)
        && request.resource.data[field] >= 0;
    }
    // a like / legit / flag counter may only move together with that user's own mark
    function markMoved(col, id, kind) {
      let path = /databases/$(database)/documents/$(col)/$(id)/$(kind)/$(me());
      return counterOnly(kind) && (
        (request.resource.data[kind] > resource.data[kind] && !exists(path) && existsAfter(path)) ||
        (request.resource.data[kind] < resource.data[kind] && exists(path) && !existsAfter(path)));
    }
    function commentCount(ownerUid) {
      return (counterOnly('comments') && request.resource.data.comments == resource.data.comments + 1)
        || (counterOnly('comments') && request.resource.data.comments == resource.data.comments - 1 && ownerUid == me());
    }
    // a repost carries a copy of the original post, which must still exist
    function repostOk(r) {
      return r is map
        && r.keys().hasOnly(['id','col','uid','name','photo','city','text','skill','media','v','pts','t'])
        && r.col in ['posts', 'results'] && str(r.id, 64) && str(r.uid, 64) && r.uid != me()
        && str(r.name, 40) && str(r.photo, 400) && str(r.city, 40) && str(r.text, 1000) && str(r.skill, 60)
        && mediaOk(r.media)
        && exists(/databases/$(database)/documents/$(r.col)/$(r.id));
    }

    // ---------- player profiles ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name','sex','sexAt','city','char','theme','photo','age','bw','interests','updatedAt'])
        && (!('name'  in request.resource.data) || str(request.resource.data.name, 40))
        && (!('sex'   in request.resource.data) || request.resource.data.sex in ['', 'm', 'f'])
        && (!('city'  in request.resource.data) || str(request.resource.data.city, 40))
        && (!('char'  in request.resource.data) || str(request.resource.data.char, 40))
        && (!('theme' in request.resource.data) || request.resource.data.theme in ['dusk', 'nightfall', 'volt'])
        && (!('photo' in request.resource.data) || str(request.resource.data.photo, 400))
        && (!('age'   in request.resource.data) || (request.resource.data.age is int && request.resource.data.age >= 0 && request.resource.data.age <= 110))
        && (!('sexAt' in request.resource.data) || request.resource.data.sexAt is int)
        && (!('interests' in request.resource.data) || (request.resource.data.interests is list && request.resource.data.interests.size() <= 20))
        && (!('bw'    in request.resource.data) || (request.resource.data.bw is number && request.resource.data.bw >= 0 && request.resource.data.bw <= 400))
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- old self-logged results (still shown in Pulse; no new ones) ----------
    match /results/{rid} {
      allow read: if signedIn();
      // players no longer log their own scores (scores come from eventResults); old results can still be read, liked and deleted
      allow create: if false;
      allow update: if isAdmin() || signedIn() && (
        markMoved('results', rid, 'likes') || markMoved('results', rid, 'legit') || markMoved('results', rid, 'flags')
        || commentCount(resource.data.uid));
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && me() == uid && request.resource.data.keys().hasOnly(['at','e']) && request.resource.data.at == request.time
          && (!('e' in request.resource.data) || request.resource.data.e in ['❤️','🔥','💪','👏','😂','😍']);
        allow delete: if signedIn() && (me() == uid || isAdmin());
      }
      match /legit/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && me() == uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
          && get(/databases/$(database)/documents/results/$(rid)).data.uid != me();   // no vouching for yourself
        allow delete: if signedIn() && (me() == uid || isAdmin());
      }
      match /flags/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && me() == uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
        allow delete: if signedIn() && (me() == uid || isAdmin());
      }
      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && notBanned()
          && request.resource.data.keys().hasOnly(['uid','name','text','at'])
          && request.resource.data.uid == me()
          && str(request.resource.data.name, 40)
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
      }
    }

    // ---------- general posts: photos / videos with a caption ----------
    match /posts/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['uid','name','city','photo','text','tags','mentions','skill','media','repost','createdAt','likes','comments','flags'])
        && request.resource.data.uid == me()
        && str(request.resource.data.name, 40) && str(request.resource.data.city, 40) && str(request.resource.data.photo, 400)
        && str(request.resource.data.text, 1000) && str(request.resource.data.skill, 60)
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 20
        && request.resource.data.mentions is list && request.resource.data.mentions.size() <= 20
        && mediaOk(request.resource.data.media)
        && (request.resource.data.text.size() > 0 || request.resource.data.media.size() > 0 || 'repost' in request.resource.data)
        && (!('repost' in request.resource.data) || repostOk(request.resource.data.repost))
        && request.resource.data.createdAt == request.time
        && request.resource.data.likes == 0 && request.resource.data.comments == 0 && request.resource.data.flags == 0;
      allow update: if isAdmin() || signedIn() && (
        markMoved('posts', pid, 'likes') || markMoved('posts', pid, 'flags') || commentCount(resource.data.uid));
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && me() == uid && request.resource.data.keys().hasOnly(['at','e']) && request.resource.data.at == request.time
          && (!('e' in request.resource.data) || request.resource.data.e in ['❤️','🔥','💪','👏','😂','😍']);
        allow delete: if signedIn() && (me() == uid || isAdmin());
      }
      match /flags/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && me() == uid && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
        allow delete: if signedIn() && (me() == uid || isAdmin());
      }
      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && notBanned()
          && request.resource.data.keys().hasOnly(['uid','name','text','at'])
          && request.resource.data.uid == me()
          && str(request.resource.data.name, 40)
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
      }
    }

    // ---------- follows (A follows B); friends = follow each other ----------
    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['from','to','fromName','toName','at'])
        && request.resource.data.from == me() && request.resource.data.to != me()
        && id == me() + '__' + request.resource.data.to
        && str(request.resource.data.fromName, 40) && str(request.resource.data.toName, 40)
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && (resource.data.from == me() || isAdmin());
    }

    // ---------- notifications: only the receiver can read them ----------
    match /notifs/{nid} {
      allow read: if signedIn() && resource.data.to == me();
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['to','from','fromName','fromPhoto','kind','ref','col','text','at','read'])
        && request.resource.data.from == me() && request.resource.data.to != me()
        && request.resource.data.kind in ['like', 'legit', 'comment', 'mention', 'repost', 'follow', 'result', 'payment', 'booking', 'join', 'meetup']
        && str(request.resource.data.to, 64) && str(request.resource.data.fromName, 40) && str(request.resource.data.fromPhoto, 400)
        && str(request.resource.data.ref, 64) && str(request.resource.data.col, 10) && str(request.resource.data.text, 140)
        && request.resource.data.at == request.time && request.resource.data.read == false;
      allow update: if signedIn() && resource.data.to == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && (resource.data.to == me() || resource.data.from == me() || isAdmin());
    }

    // ---------- direct messages: chats/{uidA__uidB} (ids sorted), messages inside ----------
    match /chats/{cid} {
      allow get: if signedIn() && me() in cid.split('__');
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['members','names','photos','last','lastFrom','lastAt','seen'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && cid == request.resource.data.members[0] + '__' + request.resource.data.members[1]
        && request.resource.data.lastFrom == me() && str(request.resource.data.last, 200)
        && request.resource.data.lastAt == request.time;
      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.keys().hasOnly(['members','names','photos','last','lastFrom','lastAt','seen'])
        && request.resource.data.members == resource.data.members
        && ((notBanned() && request.resource.data.lastFrom == me() && str(request.resource.data.last, 200) && request.resource.data.lastAt == request.time)
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']));
      match /msgs/{mid} {
        allow read: if signedIn() && me() in cid.split('__');
        allow create: if signedIn() && notBanned() && me() in cid.split('__')
          && request.resource.data.keys().hasOnly(['uid','text','at'])
          && request.resource.data.uid == me()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && resource.data.uid == me();
      }
    }

    // ---------- meetups: hosted by anyone; people join or leave by adding or removing only themselves ----------
    match /meetups/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['uid','name','photo','hobby','title','place','city','when','spots','note','members','names','cancelled','at'])
        && request.resource.data.uid == me()
        && str(request.resource.data.name, 40) && str(request.resource.data.photo, 400)
        && str(request.resource.data.hobby, 40) && request.resource.data.hobby.size() > 0
        && str(request.resource.data.title, 80) && request.resource.data.title.size() > 0
        && str(request.resource.data.place, 100) && str(request.resource.data.city, 40) && str(request.resource.data.note, 300)
        && request.resource.data.when is int && request.resource.data.when > request.time.toMillis() - 3600000
        && request.resource.data.spots is int && request.resource.data.spots >= 0 && request.resource.data.spots <= 500
        && request.resource.data.members == [me()] && request.resource.data.names.keys().hasOnly([me()])
        && request.resource.data.cancelled == false && request.resource.data.at == request.time;
      allow update: if signedIn() && (
        (resource.data.uid == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','place','when','spots','note','cancelled']))
        || (notBanned() && resource.data.cancelled == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','names'])
          && !(me() in resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([me()].toSet())
          && (resource.data.spots == 0 || request.resource.data.members.size() <= resource.data.spots)
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([me()]))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && me() in resource.data.members && me() != resource.data.uid
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([me()].toSet())));
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
    }

    // ---------- old best-result index (read and delete only) ----------
    match /best/{id} {
      allow read: if signedIn();
      allow create, update: if false;   // old rankings data, kept only so it can be read and deleted
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
    }

    // ---------- events (admin creates, players register) ----------
    match /events/{eid} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && (request.resource == null || (
          request.resource.data.keys().hasOnly(['title','skill','date','time','place','city','spots','fee','info','lat','lng','updatedAt'])
          && str(request.resource.data.title, 60) && request.resource.data.title.size() > 0
          && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.spots is int));
      // registrations; for paid events the player sends a UPI reference and only the admin can mark it paid
      match /going/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['at','name','pay','ref','amt'])
          && request.resource.data.at == request.time && str(request.resource.data.name, 40)
          && (!('pay' in request.resource.data) || (request.resource.data.pay == 'pending'
              && str(request.resource.data.ref, 40) && request.resource.data.ref.size() >= 6
              && request.resource.data.amt is int));
        allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pay'])
          && request.resource.data.pay in ['pending', 'paid', 'rejected', 'refunded'];
        allow delete: if signedIn() && ((me() == uid && resource.data.get('pay', '') != 'paid') || isAdmin());
      }
    }

    // ---------- scores from Provn events (entered by the admin) ----------
    match /eventResults/{id} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && (request.resource == null || (
          request.resource.data.keys().hasOnly(['event','eventTitle','date','place','evCity','uid','name','city','photo','sex','age','skill','v','pts','at'])
          && id == request.resource.data.event + '__' + request.resource.data.uid
          && exists(/databases/$(database)/documents/events/$(request.resource.data.event))
          && str(request.resource.data.skill, 60) && request.resource.data.skill.size() > 0
          && request.resource.data.v is number
          && request.resource.data.pts is int && request.resource.data.pts >= 0 && request.resource.data.pts <= 1400
          && str(request.resource.data.name, 40) && str(request.resource.data.city, 40)
          && request.resource.data.at == request.time));
    }

    // ---------- venues added by the admin (shown on the map) ----------
    match /venues/{vid} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && (request.resource == null || (
          request.resource.data.keys().hasOnly(['name','kind','acts','addr','phone','web','info','lat','lng','city','tier','owner','hours','updatedAt'])
          && str(request.resource.data.name, 60) && request.resource.data.name.size() > 0
          && request.resource.data.acts is list && request.resource.data.acts.size() <= 12
          && request.resource.data.lat is number && request.resource.data.lng is number));
    }

    // ---------- venue owners apply to be listed (free or partner) ----------
    match /venueApps/{id} {
      allow read: if signedIn() && (resource.data.uid == me() || isAdmin());
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['uid','by','name','contact','phone','addr','city','acts','plan','info','lat','lng','status','at'])
        && request.resource.data.uid == me() && request.resource.data.status == 'new'
        && str(request.resource.data.name, 60) && request.resource.data.name.size() > 0
        && str(request.resource.data.phone, 20) && str(request.resource.data.info, 300)
        && request.resource.data.plan in ['free', 'partner'] && request.resource.data.acts is list && request.resource.data.acts.size() <= 12
        && request.resource.data.at == request.time;
      allow update: if isAdmin();
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());
    }

    // ---------- leads: players tapping call / directions / website / booking on a Provn venue ----------
    match /venueLeads/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.owner == me());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['venue','owner','kind','uid','at'])
        && request.resource.data.uid == me()
        && request.resource.data.kind in ['view', 'call', 'dir', 'web', 'book']
        && exists(/databases/$(database)/documents/venues/$(request.resource.data.venue))
        && request.resource.data.owner == get(/databases/$(database)/documents/venues/$(request.resource.data.venue)).data.get('owner', '')
        && request.resource.data.at == request.time;
    }

    // ---------- booking requests to partner venues ----------
    match /bookings/{id} {
      allow read: if signedIn() && (resource.data.uid == me() || resource.data.owner == me() || isAdmin());
      allow create: if signedIn() && notBanned()
        && request.resource.data.keys().hasOnly(['venue','venueName','owner','uid','name','phone','date','time','people','act','note','status','at'])
        && request.resource.data.uid == me() && request.resource.data.status == 'new'
        && exists(/databases/$(database)/documents/venues/$(request.resource.data.venue))
        && request.resource.data.owner == get(/databases/$(database)/documents/venues/$(request.resource.data.venue)).data.get('owner', '')
        && str(request.resource.data.name, 40) && str(request.resource.data.phone, 20) && str(request.resource.data.note, 200)
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.people is int
        && request.resource.data.at == request.time;
      allow update: if signedIn() && (isAdmin() || resource.data.owner == me() || resource.data.uid == me())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (request.resource.data.status in ['accepted', 'declined', 'done'] && (isAdmin() || resource.data.owner == me())
            || (request.resource.data.status == 'cancelled' && resource.data.uid == me()));
    }

    // ---------- store: products listed by the admin for vendors; clicks are counted ----------
    match /products/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /productClicks/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['product','vendor','uid','at'])
        && request.resource.data.uid == me() && request.resource.data.at == request.time;
    }

    // ---------- state / national records added by the admin ----------
    match /records/{id} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && (request.resource == null || (
          request.resource.data.keys().hasOnly(['level','region','sex','skill','v','holder','date','meet','place','updatedAt'])
          && request.resource.data.level in ['state', 'national']
          && request.resource.data.sex in ['m', 'f']
          && str(request.resource.data.region, 60) && str(request.resource.data.skill, 60)
          && request.resource.data.v is number && str(request.resource.data.holder, 80)));
    }

    // ---------- app settings (announcement, map key, UPI payment details) ----------
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- admin-only settings (test bot logins) ----------
    match /private/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- players banned from posting ----------
    match /bans/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // everything else is closed
    match /{document=**} { allow read, write: if false; }
  }
}
